{
  "name": "online-code-sandbox",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "scripts": {
    "build:shared": "pnpm --filter @online-code-sandbox/shared build",
    "dev:api": "pnpm build:shared && dotenv -e .env -- pnpm --filter api dev",
    "dev:worker": "pnpm build:shared && dotenv -e .env -- pnpm --filter worker dev",
    "dev:web": "pnpm build:shared && dotenv -e .env -- pnpm --filter web dev",
    "build": "pnpm build:shared && pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yaml,yml}": [
      "prettier --write"
    ]
  }
}
